APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Yangon

APP_BUSINESS_ADDRESS="Bet 59-60, 19 Street, Aungmyaetharsan Township, Mandalay, Myanmar"
APP_BUSINESS_CITY="Mandalay, Myanmar"
APP_BUSINESS_PHONE="+95 9 792 115 547"
APP_FRONTEND_URL=https://pyonea.com
# Public URL for icon.png in email headers (defaults to APP_FRONTEND_URL/icon.png if unset).
APP_LOGO_URL=https://pyonea.com/icon.png

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Real-time messaging (WebSocket) ---
# Local dev: BROADCAST_CONNECTION=reverb + REVERB_* below.
# Shared hosting (Namecheap / cPanel): use Pusher.com free tier — no WebSocket server on your host.
#   1. Create app at https://dashboard.pusher.com (Channels, cluster e.g. ap1)
#   2. Set BROADCAST_CONNECTION=pusher and PUSHER_* below on api.pyonea.com
#   3. Mobile/web clients connect to Pusher; Laravel broadcasts via HTTP API
BROADCAST_CONNECTION=reverb

# Pusher (production on shared hosting)
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=ap1

# Laravel Reverb (local dev only — requires `php artisan reverb:start`)
REVERB_APP_ID=pyonea-local
REVERB_APP_KEY=pyonea-reverb-key
REVERB_APP_SECRET=pyonea-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Push notifications (Pusher Beams) ---
# Create a Beams instance at https://dashboard.pusher.com/beams
# Upload FCM credentials from Firebase project pyonea-74083 (same google-services.json as the app)
BEAMS_INSTANCE_ID=
BEAMS_SECRET_KEY=
# Set true to dispatch via Beams alongside Expo push during migration
BEAMS_PUSH_ENABLED=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# --- cPanel webmail (production) — Email Accounts → Connect Devices ---
# Recommended (SSL/TLS):
# MAIL_MAILER=smtp
# MAIL_HOST=pyonea.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# MAIL_SCHEME=null
# MAIL_USERNAME=no-reply@pyonea.com
# MAIL_PASSWORD=
# MAIL_EHLO_DOMAIN=pyonea.com
#
# Alternative (not recommended): MAIL_HOST=mail.pyonea.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls

# Default From for mail that does not set its own identity (use literal emails — never ${APP_NAME}).
MAIL_FROM_ADDRESS="no-reply@pyonea.com"
MAIL_FROM_NAME="Pyonea"
MAIL_REPLY_TO_ADDRESS="support@pyonea.com"
MAIL_REPLY_TO_NAME="Pyonea Support"

# Branded sender identities (From header per category; must be aliases on MAIL_USERNAME mailbox).
MAIL_TRANSACTIONAL_FROM="no-reply@pyonea.com"
MAIL_TRANSACTIONAL_NAME="Pyonea"
MAIL_WELCOME_FROM="hi@pyonea.com"
MAIL_WELCOME_NAME="Pyonea"
MAIL_CONTACT_ADDRESS="contact@pyonea.com"
MAIL_CONTACT_NAME="Pyonea Contact"
MAIL_SUPPORT_ADDRESS="support@pyonea.com"
MAIL_SUPPORT_NAME="Pyonea Support"
MAIL_NEWSLETTER_FROM="no-reply@pyonea.com"
MAIL_NEWSLETTER_NAME="Pyonea"

# Inbox for internal admin alerts (reports, subscription expiry, etc.).
ADMIN_REPORT_EMAIL=support@pyonea.com
MAIL_EHLO_DOMAIN=pyonea.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS: default true for Sanctum cookie / credentialed SPA. Set false only for Bearer-only API.
# CORS_SUPPORTS_CREDENTIALS=true

# --- Production security (optional) ---
# APP_DEBUG=false
RECAPTCHA_SITE_KEY=6LfAMk8tAAAAADSiZB2pa6Rn8mO32NXuQSwOfHBK
# RECAPTCHA_SECRET_KEY=
# SANCTUM_TOKEN_EXPIRATION=10080

#SENTRY DSN SETUP TO TRACK ERRORS IN PRODUCTION


# --- Google OAuth (token verification only; no server-side callback required) ---
# Must match EXPO_PUBLIC_GOOGLE_CLIENT_ID / web client in the native app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web SPA redirect (optional; used by frontend OAuth if applicable)
GOOGLE_REDIRECT_URI="${APP_FRONTEND_URL}/auth/google/callback"
# Keep secret values only in real server .env files. Never expose them to the frontend.
MYANMYANPAY_APP_ID=
MYANMYANPAY_PUBLIC_KEY=
MYANMYANPAY_SECRET_KEY=
MYANMYANPAY_API_URL=
MYANMYANPAY_WEBHOOK_SECRET=
