APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Yangon

APP_BUSINESS_ADDRESS="Bet 59-60, 19 Street, Aungmyaetharsan Township, Mandalay, Myanmar"
APP_BUSINESS_CITY="Mandalay, Myanmar"
APP_BUSINESS_PHONE="+95 9 792 115 547"

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Use smtp for production. MAIL_SCHEME is optional; MAIL_ENCRYPTION=tls maps to smtp on port 587.
MAIL_SCHEME=null
MAIL_ENCRYPTION=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Prefer a domain address (e.g. support@pyonea.com) once Google Workspace / DNS is configured.
MAIL_REPLY_TO_ADDRESS="${MAIL_FROM_ADDRESS}"
MAIL_REPLY_TO_NAME="${MAIL_FROM_NAME}"
# Set to your sending domain for better SMTP reputation (e.g. pyonea.com).
MAIL_EHLO_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS: default true for Sanctum cookie / credentialed SPA. Set false only for Bearer-only API.
# CORS_SUPPORTS_CREDENTIALS=true

# --- Production security (optional) ---
# APP_DEBUG=false
# RECAPTCHA_SECRET_KEY=
# SANCTUM_TOKEN_EXPIRATION=10080

# --- Google OAuth (token verification only; no server-side callback required) ---
# Must match EXPO_PUBLIC_GOOGLE_CLIENT_ID / web client in the native app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Web SPA redirect (optional; used by frontend OAuth if applicable)
GOOGLE_REDIRECT_URI="${APP_FRONTEND_URL}/auth/google/callback"
# Keep secret values only in real server .env files. Never expose them to the frontend.
MYANMYANPAY_APP_ID=
MYANMYANPAY_PUBLIC_KEY=
MYANMYANPAY_SECRET_KEY=
MYANMYANPAY_API_URL=
MYANMYANPAY_WEBHOOK_SECRET=
